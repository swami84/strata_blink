diff --git a/include/strata/core/blink.hpp b/include/strata/core/blink.hpp
new file mode 100644
index 0000000..5dcee96
--- /dev/null
+++ b/include/strata/core/blink.hpp
@@ -0,0 +1,27 @@
+#pragma once
+// strata::blink - a GPU-resident decode loop after Blink (arXiv 2604.07609), step by step.
+//
+// M1 (STRATA_BLINK_DEVLAUNCH=1): the verify / commit / MTP graphs are instantiated for device launch and every launch of
+// them goes through a one-node launcher graph whose kernel fires the real graph from the GPU (fire-and-forget). The host
+// still drives the loop and syncs exactly as before (a stream sync covers the fire-and-forget child); this proves the
+// graphs run, bit for bit, when the GPU launches them.  Off (the default): plain cudaGraphInstantiate / cudaGraphLaunch.
+#include <cuda_runtime.h>
+
+namespace strata::blink {
+
+#if defined(STRATA_USE_HIP) || defined(STRATA_HIP_GFX906) || defined(STRATA_GPU_METAL)
+inline bool devlaunch_on() { return false; }
+inline cudaError_t instantiate(cudaGraphExec_t* ex, cudaGraph_t g, unsigned long long flags) {
+    return cudaGraphInstantiate(ex, g, flags);
+}
+inline cudaError_t launch(cudaGraphExec_t ex, cudaStream_t s) { return cudaGraphLaunch(ex, s); }
+#else
+/// STRATA_BLINK_DEVLAUNCH=1
+bool devlaunch_on();
+/// cudaGraphInstantiate, plus cudaGraphInstantiateFlagDeviceLaunch and registration when devlaunch_on()
+cudaError_t instantiate(cudaGraphExec_t* ex, cudaGraph_t g, unsigned long long flags);
+/// a registered graph: launched from the device through its launcher; any other graph: cudaGraphLaunch
+cudaError_t launch(cudaGraphExec_t ex, cudaStream_t s);
+#endif
+
+}  // namespace strata::blink
