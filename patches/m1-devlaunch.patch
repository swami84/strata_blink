diff --git a/src/core/blink.cu b/src/core/blink.cu
new file mode 100644
index 0000000..930eed3
--- /dev/null
+++ b/src/core/blink.cu
@@ -0,0 +1,125 @@
+// src/core/blink.cu - see include/strata/core/blink.hpp.  Built as its own static library with relocatable device code
+// (the device runtime's cudaGraphLaunch), so no other Strata target changes how it is compiled.
+#include "strata/core/blink.hpp"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+
+namespace strata::blink {
+namespace {
+
+// Fires `g` from the device.  A failure is recorded (first error wins) for the host to report at its next launch.
+__global__ void ff_launch(cudaGraphExec_t g, int* err) {
+    if (threadIdx.x != 0 || blockIdx.x != 0) return;
+    const cudaError_t e = cudaGraphLaunch(g, cudaStreamGraphFireAndForget);
+    if (e != cudaSuccess) atomicCAS(err, 0, (int) e);
+}
+
+struct Registry {
+    std::mutex mu;
+    std::unordered_set<cudaGraphExec_t> device;                      // instantiated for device launch
+    std::unordered_set<cudaGraphExec_t> uploaded;
+    std::unordered_map<cudaGraphExec_t, cudaGraphExec_t> launcher;   // child -> its launcher graph
+    int* h_err = nullptr;                                            // mapped, portable
+    int* d_err = nullptr;
+    std::atomic<long long> launches{0};
+};
+Registry& reg() {
+    static Registry r;
+    return r;
+}
+
+bool ensure_err(Registry& r) {
+    if (r.h_err != nullptr) return true;
+    if (cudaHostAlloc((void**) &r.h_err, sizeof(int), cudaHostAllocMapped | cudaHostAllocPortable) != cudaSuccess) return false;
+    *(volatile int*) r.h_err = 0;
+    return cudaHostGetDevicePointer((void**) &r.d_err, r.h_err, 0) == cudaSuccess;
+}
+
+cudaError_t make_launcher(Registry& r, cudaGraphExec_t child, cudaGraphExec_t* out) {
+    cudaGraph_t g = nullptr;
+    cudaError_t e = cudaGraphCreate(&g, 0);
+    if (e != cudaSuccess) return e;
+    cudaKernelNodeParams kp{};
+    void* args[] = {&child, &r.d_err};
+    kp.func = (void*) ff_launch;
+    kp.gridDim = dim3(1);
+    kp.blockDim = dim3(32);
+    kp.kernelParams = args;
+    cudaGraphNode_t n = nullptr;
+    e = cudaGraphAddKernelNode(&n, g, nullptr, 0, &kp);
+    if (e == cudaSuccess) e = cudaGraphInstantiate(out, g, 0);
+    cudaGraphDestroy(g);
+    return e;
+}
+
+}  // namespace
+
+bool devlaunch_on() {
+    static const bool on = [] {
+        const char* v = std::getenv("STRATA_BLINK_DEVLAUNCH");
+        const bool o = v != nullptr && std::atoi(v) != 0;
+        if (o) std::fprintf(stderr, "strata blink: M1 on - verify / commit / MTP graphs are launched from the GPU (fire-and-forget)\n");
+        return o;
+    }();
+    return on;
+}
+
+cudaError_t instantiate(cudaGraphExec_t* ex, cudaGraph_t g, unsigned long long flags) {
+    if (!devlaunch_on()) return cudaGraphInstantiate(ex, g, flags);
+    const cudaError_t e = cudaGraphInstantiate(ex, g, flags | cudaGraphInstantiateFlagDeviceLaunch);
+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "strata blink: instantiate for device launch failed: %s\n", cudaGetErrorString(e));
+        return e;
+    }
+    Registry& r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    r.device.insert(*ex);
+    r.uploaded.erase(*ex);   // a reused handle value is a new graph
+    r.launcher.erase(*ex);
+    return e;
+}
+
+cudaError_t launch(cudaGraphExec_t ex, cudaStream_t s) {
+    if (!devlaunch_on()) return cudaGraphLaunch(ex, s);
+    // the graph's own flags, not a registry: Strata destroys and recaptures graphs, and a handle value can come back
+    unsigned long long fl = 0;
+    if (cudaGraphExecGetFlags(ex, &fl) != cudaSuccess || (fl & cudaGraphInstantiateFlagDeviceLaunch) == 0)
+        return cudaGraphLaunch(ex, s);   // not instantiated for device launch: as before
+    Registry& r = reg();
+    cudaGraphExec_t le = nullptr;
+    {
+        std::lock_guard<std::mutex> lk(r.mu);
+        if (!ensure_err(r)) return cudaErrorMemoryAllocation;
+        if (const int de = *(volatile int*) r.h_err; de != 0) {
+            std::fprintf(stderr, "strata blink: an earlier device-side graph launch failed: %s\n",
+                         cudaGetErrorString((cudaError_t) de));
+            return (cudaError_t) de;
+        }
+        if (r.uploaded.insert(ex).second) {
+            const cudaError_t ue = cudaGraphUpload(ex, s);   // a device launch needs the graph on the device first
+            if (ue != cudaSuccess) {
+                r.uploaded.erase(ex);
+                return ue;
+            }
+        }
+        auto it = r.launcher.find(ex);
+        if (it == r.launcher.end()) {
+            const cudaError_t me = make_launcher(r, ex, &le);
+            if (me != cudaSuccess) return me;
+            r.launcher.emplace(ex, le);
+        } else {
+            le = it->second;
+        }
+    }
+    const long long n = ++r.launches;
+    if (n == 1 || n == 1000 || n == 100000)
+        std::fprintf(stderr, "strata blink: %lld device-side graph launches so far\n", n);
+    return cudaGraphLaunch(le, s);
+}
+
+}  // namespace strata::blink
