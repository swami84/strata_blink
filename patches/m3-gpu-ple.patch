+
+Loop::~Loop() {
+    if (ctl_ != nullptr) cudaFreeHost(ctl_);
+}
+
+bool Loop::start(const LoopArgs& a, std::string& err) {
+    DevGuard guard;
+    dev0_ = a.dev0;
+    dev1_ = a.dev1;
+    auto ck = [&](cudaError_t e, const char* what) {
+        if (e == cudaSuccess) return true;
+        err = std::string("blink: ") + what + ": " + cudaGetErrorString(e);
+        return false;
+    };
+    if (ctl_ == nullptr) {
+        if (!ck(cudaHostAlloc((void**) &ctl_, sizeof(Ctl), cudaHostAllocMapped | cudaHostAllocPortable), "control block"))
+            return false;
+        if (!ck(cudaHostGetDevicePointer((void**) &ctl_dev_, ctl_, 0), "control block pointer")) return false;
+    }
+    std::memset((void*) ctl_, 0, offsetof(Ctl, ring));
+    ctl_->p0 = a.p0;
+    ctl_->max_new = a.max_new;
+    ctl_->produced0 = a.produced0;
+    ctl_->max_context = a.max_context;
+    ctl_->x0 = a.x0;
+    ctl_->S_mtp = a.S_mtp;
+    ctl_->first_window = a.first_window;
+    ctl_->min_p = a.min_p;
+    ctl_->n_eos = a.n_eos < kMaxEos ? a.n_eos : kMaxEos;
+    for (int i = 0; i < ctl_->n_eos; ++i) ctl_->eos[i] = a.eos[i];
+    ctl_->ple_prev0[0] = a.ple_prev[0];
+    ctl_->ple_prev0[1] = a.ple_prev[1];
+    ctl_->produced = a.produced0;
+    ctl_->consumed = a.produced0;
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+
+    St1 s1{};
+    s1.w = 0;
+    s1.x = a.x0;
+    s1.first = a.first_window;
+    s1.p = a.p0;
+    s1.produced = a.produced0;
+    for (int i = 0; i < kMaxT; ++i) {
+        s1.drafts[i] = a.drafts[i];
+        s1.dprob[i] = a.dprob[i];
+    }
+    s1.pen_n = a.pen_n < kPenCap ? a.pen_n : kPenCap;
+    for (int i = 0; i < s1.pen_n; ++i) s1.pen_tail[i] = a.pen_tail[i];
+    St0 s0{};
+    s0.ple_prev[0] = a.ple_prev[0];
+    s0.ple_prev[1] = a.ple_prev[1];
+
+    // GPU0: its stage
+    if (!ck(cudaSetDevice(dev0_), "device 0")) return false;
+    if (d_s0_ == nullptr) {
+        if (!ck(cudaMalloc((void**) &d_s0_, sizeof(StageDesc)), "desc 0") || !ck(cudaMalloc(&st0_, sizeof(St0)), "state 0") ||
+            !ck(cudaStreamCreateWithFlags(&q0_, cudaStreamNonBlocking), "stream 0"))
+            return false;
+    }
+    if (!ck(cudaMemcpy(d_s0_, &a.s0, sizeof(StageDesc), cudaMemcpyHostToDevice), "desc 0 copy") ||
+        !ck(cudaMemcpy(st0_, &s0, sizeof(St0), cudaMemcpyHostToDevice), "state 0 copy"))
+        return false;
+    if (a.s0.ple_mode == 2 && ple_g_ == nullptr) {
+        if (!ck(cudaMalloc((void**) &ple_in_, sizeof(int) * (3 + kMaxT)), "PLE input")) return false;
+        cudaGraph_t pg = nullptr;
+        if (!ck(cudaStreamBeginCapture(q0_, cudaStreamCaptureModeThreadLocal), "PLE capture")) return false;
+        ple_gather_kernel<<<16 * kMaxT, 160, 0, q0_>>>(d_s0_, ple_in_);
+        ple_flag_kernel<<<1, 1, 0, q0_>>>(d_s0_);
+        if (!ck(cudaStreamEndCapture(q0_, &pg), "PLE capture end")) return false;
+        const cudaError_t ie = cudaGraphInstantiateWithFlags(&ple_g_, pg, cudaGraphInstantiateFlagDeviceLaunch);
+        cudaGraphDestroy(pg);
+        if (!ck(ie, "PLE graph") || !ck(cudaGraphUpload(ple_g_, q0_), "PLE graph upload") || !ck(cudaStreamSynchronize(q0_), "PLE graph sync"))
+            return false;
+    }
+    s0.ple_in = ple_in_;
+    s0.ple_g = ple_g_;
+    if (!ck(cudaMemcpy(st0_, &s0, sizeof(St0), cudaMemcpyHostToDevice), "state 0 copy")) return false;
+    if (g0_ == nullptr && !ck(make_sched_graph(q0_, true, d_s0_, nullptr, ctl_dev_, st0_, &g0_), "scheduler 0 graph")) return false;
+    // GPU1: its stage and the drafter
+    if (!ck(cudaSetDevice(dev1_), "device 1")) return false;
+    if (d_s1_ == nullptr) {
+        if (!ck(cudaMalloc((void**) &d_s1_, sizeof(StageDesc)), "desc 1") || !ck(cudaMalloc((void**) &d_mtp_, sizeof(MtpDesc)), "desc mtp") ||
+            !ck(cudaMalloc(&st1_, sizeof(St1)), "state 1") || !ck(cudaStreamCreateWithFlags(&q1_, cudaStreamNonBlocking), "stream 1"))
+            return false;
+    }
+    if (!ck(cudaMemcpy(d_s1_, &a.s1, sizeof(StageDesc), cudaMemcpyHostToDevice), "desc 1 copy") ||
+        !ck(cudaMemcpy(d_mtp_, &a.mtp, sizeof(MtpDesc), cudaMemcpyHostToDevice), "desc mtp copy") ||
+        !ck(cudaMemcpy(st1_, &s1, sizeof(St1), cudaMemcpyHostToDevice), "state 1 copy"))
+        return false;
+    if (g1_ == nullptr && !ck(make_sched_graph(q1_, false, d_s1_, d_mtp_, ctl_dev_, st1_, &g1_), "scheduler 1 graph")) return false;
+    // go: GPU0 first (it waits for the first window)
+    if (!ck(cudaSetDevice(dev0_), "device 0") || !ck(cudaGraphLaunch(g0_, q0_), "scheduler 0 launch")) return false;
+    if (!ck(cudaSetDevice(dev1_), "device 1") || !ck(cudaGraphLaunch(g1_, q1_), "scheduler 1 launch")) return false;
+    return true;
+}
+
+bool Loop::wait(std::string& err) {
+    DevGuard guard;
+    cudaSetDevice(dev1_);
+    const cudaError_t e1 = cudaStreamSynchronize(q1_);
+    cudaSetDevice(dev0_);
+    const cudaError_t e0 = cudaStreamSynchronize(q0_);
+    if (e0 != cudaSuccess || e1 != cudaSuccess) {
+        err = std::string("blink: scheduler: ") + cudaGetErrorString(e0 != cudaSuccess ? e0 : e1);
+        return false;
+    }
+    return true;
+}
