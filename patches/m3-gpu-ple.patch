+        return false;
+    }
+    d = strata::blink::MtpDesc{};
+    d.tok = m_tok_; d.step = m_step_; d.pos = m_pos_; d.out = m_out_; d.row = m_row_; d.force = m_force_; d.prob = m_prob_;
+    d.n_head = (int) g_->n_head;
