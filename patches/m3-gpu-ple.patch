diff --git a/include/strata/core/blink.hpp b/include/strata/core/blink.hpp
new file mode 100644
index 0000000..5727473
--- /dev/null
+++ b/include/strata/core/blink.hpp
@@ -0,0 +1,188 @@
+#pragma once
+// strata::blink - a GPU-resident decode loop after Blink (arXiv 2604.07609), extended to a two-GPU layer split.
+//
+// M1 (STRATA_BLINK_DEVLAUNCH=1): the verify / commit / MTP graphs are instantiated for device launch and every launch of
+//   them goes through a one-node launcher graph whose kernel fires the real graph from the GPU.  The host still drives the
+//   loop and syncs as before (a stream sync covers the fire-and-forget child).
+// M2 (STRATA_BLINK=1, implies M1's instantiation): the decode loop itself runs on the GPUs.  One persistent scheduler per
+//   GPU (a one-warp kernel in a device-launchable graph, tail-relaunched before the 120 fire-and-forget launches a graph
+//   execution may make):
+//     GPU1 (the last stage: head + MTP drafter): picks the window (the --spec-min-p rule), stages its rows, runs its half,
+//       accepts the drafts, commits, publishes the tokens to a ring in mapped host memory, drafts the next window.
+//     GPU0 (the first stage): waits for each window, stages its rows, runs its half, commits.
+//   The two talk through a control block in mapped pinned host memory (no peer access on these cards); every graph the
+//   loop launches ends with a counter bump (capture_done) so the scheduler knows when it has finished.  The host only
+//   prints the ring's tokens, passes a STOP on, and (M2) serves the first stage's PLE rows.
+// Off (the default): plain cudaGraphInstantiate / cudaGraphLaunch, nothing else changes.
+#include <cuda_runtime.h>
+
+#include <cstdint>
+#include <string>
+
+namespace strata::blink {
+
+constexpr int kMaxT = 8;          // the build's widest verify window ("verify / batch windows hold up to 8 rows")
+constexpr int kRing = 1 << 16;    // emitted tokens in flight between the GPU and the host
+constexpr int kMaxEos = 8;
+constexpr int kFFLimit = 120;     // CUDA: fire-and-forget launches one graph execution may make
+constexpr int kPenCap = 256;      // the longest penalty window the loop keeps (penalty_last_n)
+
+/// One Verifier (a stage of the layer split): where its window graph reads its per-window inputs, and its graphs.
+struct StageDesc {
+    int32_t* tok = nullptr;       // mapped: T
+    int32_t* step = nullptr;      // mapped: T * 4 (pos, n_kv, n_bid, width)
+    int32_t* pos = nullptr;       // mapped: q heads, then kv heads, then indexer heads, max_t rows each
+    uint32_t* seq = nullptr;
+    uint32_t* flag = nullptr;     // the PLE flag (the first stage's layer 1 waits for it)
+    uint32_t* flagA = nullptr;
+    uint32_t* flagB = nullptr;
+    uint32_t* hflag_out = nullptr;   // the overlapped split's hand-off flag (may be null)
+    uint32_t* herr = nullptr;        // (may be null)
+    uint32_t* hdrop = nullptr;       // (may be null)
+    int32_t* commit = nullptr;    // mapped: [n_keep, n_keep - 1, pos_0 .. pos_{max_t-1}]
+    int32_t* out = nullptr;       // mapped: the argmax per row (last stage)
+    uint32_t* nf = nullptr;       // mapped: non-finite flags, kVerifyMaxT * nf_blocks (last stage with the guard on)
+    int nf_blocks = 0;
+    uint32_t* plan_err = nullptr;
+    int n_head = 0, n_head_kv = 0, idx_q_heads = 0, idx_block = 1, idx_top_k = 0, max_t = 0;
+    int self_commit_t1 = 0;       // a one-row window advanced the state itself: no commit graph
+    cudaGraphExec_t win[kMaxT + 1] = {};   // win[T]
+    cudaGraphExec_t commit_exec = nullptr;
+    unsigned* done = nullptr;     // this device's counter, bumped at the end of every loop graph
+    int device = -1;
+    // greedy with repetition penalties (last stage): the penalised pick runs again after the window, over `hist`
+    cudaGraphExec_t samp[kMaxT + 1] = {};
+    int32_t* hist = nullptr;      // device: T rows of hist_len slots, most recent last, -1 in the unused front slots
+    int hist_len = 0;
+    // the first stage's PLE rows: 0 none (the flag is raised at once), 1 the host gathers them (M2), 2 the GPU does (M3)
+    int ple_mode = 0;
+    const uint8_t* ple_table = nullptr;   // M3: the IQ4_NL table in registered host memory (the device's address)
+    unsigned long long ple_rows = 0;
+    float* ple_out = nullptr;             // M3: the stage's mapped PLE input (T x 16 rows x 160 floats)
+    unsigned long long ple_mult[3] = {}, ple_vocab[16] = {}, ple_offset[16] = {};
+};
+
+/// The MTP drafter (on the last stage's GPU).
+struct MtpDesc {
+    int32_t* tok = nullptr;
+    int32_t* step = nullptr;
+    int32_t* pos = nullptr;
+    int32_t* out = nullptr;
+    int32_t* row = nullptr;
+    int32_t* force = nullptr;     // (may be null)
+    float* prob = nullptr;
+    int n_head = 0, max_t = 0, max_drafts = 0, catchup_all = 0;
+    long long max_cells = 0;
+    cudaGraphExec_t round[kMaxT + 1] = {};   // round[T]
+    cudaGraphExec_t step_g[kMaxT + 1] = {};  // step_g[j]
+    unsigned* done = nullptr;
+    int device = -1;
+};
+
+enum Finish : int { kRunning = 0, kLength = 1, kStop = 2, kCancel = 3, kNonfinite = 4, kContext = 5, kError = 9 };
+
+/// Mapped pinned host memory (portable): the host and both GPUs.  The GPUs read and write it with volatile accesses and
+/// system fences; the host the same way (volatile, seq_cst fences).
+struct Ctl {
+    // the request (the host, before start)
+    long long p0, max_new, produced0, max_context;
+    int x0, S_mtp, n_eos, first_window;
+    int eos[kMaxEos];
+    float min_p;
+    int ple_prev0[2];
+    // GPU1 -> GPU0: the window
+    int win_seq, T;
+    long long p;
+    int tokens[kMaxT];
+    // GPU0 -> GPU1: its half of window win_seq is done / its commit is done
+    int s0_done, s0_commit_done;
+    // GPU1 -> GPU0
+    int commit_seq, n_keep, exit_req;
+    // GPU0 -> host -> the first stage's graph (M2): the PLE rows of a window
+    int ple_seq, ple_T, ple_done;
+    int ple_tokens[kMaxT];
+    int ple_prev[2];
+    // host -> GPU
+    int stop;
+    long long consumed;           // ring entries the host has printed
+    // GPU -> host
+    long long produced;           // ring entries published
+    int finished;                 // a Finish value once GPU1 is done
+    int err, err_where;
+    long long p_end, windows, offered, accepted, launches1, launches0, relaunches1, relaunches0;
+    int x_end, last_T, last_a;
+    long long last_p;
+    int last_window[kMaxT];
+    int ple_prev_end[2];
+    int ring[kRing];
+};
+
+/// What generate.cpp hands the loop.
+struct LoopArgs {
+    StageDesc s0, s1;
+    MtpDesc mtp;
+    int dev0 = 0, dev1 = 1;
+    long long p0 = 0, max_new = 0, produced0 = 0, max_context = 0;
+    int x0 = 0, S_mtp = 1, first_window = 1;
+    float min_p = 0.5f;
+    int eos[kMaxEos] = {};
+    int n_eos = 0;
+    int ple_prev[2] = {0, 0};
+    int drafts[kMaxT] = {};
+    float dprob[kMaxT] = {};
+    int pen_tail[kPenCap] = {};   // the last pen_n tokens the state consumed since the penalties' window began
+    int pen_n = 0;
+};
+
+#if defined(STRATA_USE_HIP) || defined(STRATA_HIP_GFX906) || defined(STRATA_GPU_METAL)
+inline bool devlaunch_on() { return false; }
+inline bool loop_on() { return false; }
+inline void capture_done(cudaStream_t) {}
+inline void prepare_device(int) {}
+inline const void* register_table(const void*, size_t) { return nullptr; }
+inline cudaError_t instantiate(cudaGraphExec_t* ex, cudaGraph_t g, unsigned long long flags) {
+    return cudaGraphInstantiate(ex, g, flags);
+}
+inline cudaError_t launch(cudaGraphExec_t ex, cudaStream_t s) { return cudaGraphLaunch(ex, s); }
+#else
+/// STRATA_BLINK_DEVLAUNCH=1 or STRATA_BLINK=1
+bool devlaunch_on();
+/// STRATA_BLINK=1: the GPU-resident decode loop
+bool loop_on();
+/// (inside a capture) the end-of-graph counter bump the loop waits on; a no-op unless loop_on()
+void capture_done(cudaStream_t s);
+/// once per device, outside any capture (Verifier::init, MtpDrafter::load): the counter, and the loop's kernels loaded
+void prepare_device(int device);
+/// this device's counter (prepare_device made it; nullptr if it did not)
+unsigned* done_counter(int device);
+/// M3: register host memory (the PLE table, read only) for every GPU once; its device address, or nullptr
+const void* register_table(const void* p, size_t bytes);
+/// cudaGraphInstantiate, plus cudaGraphInstantiateFlagDeviceLaunch when devlaunch_on()
+cudaError_t instantiate(cudaGraphExec_t* ex, cudaGraph_t g, unsigned long long flags);
+/// a graph instantiated for device launch: launched from the device through its launcher; any other: cudaGraphLaunch
+cudaError_t launch(cudaGraphExec_t ex, cudaStream_t s);
+
+/// One request's decode loop on the GPUs.
+class Loop {
+public:
+    ~Loop();
+    bool start(const LoopArgs& a, std::string& err);   // launches both schedulers; returns at once
+    Ctl* ctl() const { return ctl_; }                  // the host's view (volatile accesses)
+    bool wait(std::string& err);                        // after ctl()->finished: both schedulers have exited
+private:
+    Ctl* ctl_ = nullptr;
+    Ctl* ctl_dev_ = nullptr;
+    void* st0_ = nullptr;
+    void* st1_ = nullptr;
+    StageDesc* d_s0_ = nullptr;
+    StageDesc* d_s1_ = nullptr;
+    MtpDesc* d_mtp_ = nullptr;
+    cudaStream_t q0_ = nullptr, q1_ = nullptr;
+    cudaGraphExec_t g0_ = nullptr, g1_ = nullptr;
+    int* ple_in_ = nullptr;               // M3: device, [T, prev0, prev1, tokens...]
+    cudaGraphExec_t ple_g_ = nullptr;     // M3: the gather graph (GPU0)
+    int dev0_ = 0, dev1_ = 1;
+};
+#endif
+
+}  // namespace strata::blink
