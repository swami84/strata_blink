+bool Verifier::blink_ple_serve(const int32_t* tokens, int T, const int32_t* prev, std::string& err) {
+    using namespace strata::kernels;
+    SessionState& ss = *ss_;
+    if (ss.ple.ready() && ple_stage()) {
+        uint32_t ple_rows[kVerifyLongT * PLE_N_HEADS];
+        int32_t pv[2] = {prev[0], prev[1]};
+        for (int t = 0; t < T; ++t) {   // as run(): the rows from each token and the two before it
+            ngram_rows(&tokens[t], pv, 1, ss.ple.consts, ple_rows + t * PLE_N_HEADS);
+            pv[0] = pv[1];
+            pv[1] = tokens[t];
+            ss.ple.table->prefetch_rows(ple_rows + t * PLE_N_HEADS);
+        }
+        if (!ss.ple.table->gather_batch(ple_rows, (size_t) T, h_ple_, err)) return false;
+        std::atomic_thread_fence(std::memory_order_seq_cst);
+        strata_store_fence();
+    }
+    *(volatile uint32_t*) h_flag_ = 1;
+    return true;
+}
+
+void Verifier::blink_after(int last_T, int64_t last_pos0, const int32_t* last_tokens, int64_t n_windows, const int32_t* ple_prev) {
+    last_t_ = last_T;
+    last_pos0_ = last_pos0;
+    for (int t = 0; t < last_T && t < max_t_; ++t) last_tokens_[t] = last_tokens[t];
+    windows += n_windows;
+    staged_ = false;
+    nf_row_ = -1;
+    nf_pos_ = -1;
+    nf_mask_ = 0;
+    if (ple_prev != nullptr && ple_stage()) {
+        ss_->ple_prev[0] = ple_prev[0];
+        ss_->ple_prev[1] = ple_prev[1];
+    }
+}
