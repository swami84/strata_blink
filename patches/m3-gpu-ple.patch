diff --git a/src/core/blink.cu b/src/core/blink.cu
new file mode 100644
index 0000000..c47ab24
--- /dev/null
+++ b/src/core/blink.cu
@@ -0,0 +1,803 @@
+// src/core/blink.cu - see include/strata/core/blink.hpp.  Built as its own static library with relocatable device code
+// (the device runtime's cudaGraphLaunch), so no other Strata target changes how it is compiled.
+#include "strata/core/blink.hpp"
+
+#include <atomic>
+#include <chrono>
+#include <cuda_fp16.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstddef>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+#include <algorithm>
+#include <thread>
+#include <vector>
+
+namespace strata::blink {
+namespace {
+
+// ---------------------------------------------------------------------------------------------------------------
+// M1: device-side launch of the engine's graphs, the host still driving
+// ---------------------------------------------------------------------------------------------------------------
+
+__global__ void ff_launch(cudaGraphExec_t g, int* err) {
+    if (threadIdx.x != 0 || blockIdx.x != 0) return;
+    const cudaError_t e = cudaGraphLaunch(g, cudaStreamGraphFireAndForget);
+    if (e != cudaSuccess) atomicCAS(err, 0, (int) e);
+}
+
+__global__ void done_bump(unsigned* c) {
+    __threadfence_system();   // everything the graph wrote before this node (mapped outputs included) is visible first
+    atomicAdd(c, 1u);
+}
+
+struct Registry {
+    std::mutex mu;
+    std::unordered_set<cudaGraphExec_t> uploaded;
+    std::unordered_map<cudaGraphExec_t, cudaGraphExec_t> launcher;   // child -> its launcher graph
+    int* h_err = nullptr;                                            // mapped, portable
+    int* d_err = nullptr;
+    std::atomic<long long> launches{0};
+    unsigned* done[16] = {};
+};
+Registry& reg() {
+    static Registry r;
+    return r;
+}
+
+bool ensure_err(Registry& r) {
+    if (r.h_err != nullptr) return true;
+    if (cudaHostAlloc((void**) &r.h_err, sizeof(int), cudaHostAllocMapped | cudaHostAllocPortable) != cudaSuccess) return false;
+    *(volatile int*) r.h_err = 0;
+    return cudaHostGetDevicePointer((void**) &r.d_err, r.h_err, 0) == cudaSuccess;
+}
+
+cudaError_t make_launcher(Registry& r, cudaGraphExec_t child, cudaGraphExec_t* out) {
+    cudaGraph_t g = nullptr;
+    cudaError_t e = cudaGraphCreate(&g, 0);
+    if (e != cudaSuccess) return e;
+    cudaKernelNodeParams kp{};
+    void* args[] = {&child, &r.d_err};
+    kp.func = (void*) ff_launch;
+    kp.gridDim = dim3(1);
+    kp.blockDim = dim3(32);
+    kp.kernelParams = args;
+    cudaGraphNode_t n = nullptr;
+    e = cudaGraphAddKernelNode(&n, g, nullptr, 0, &kp);
+    if (e == cudaSuccess) e = cudaGraphInstantiate(out, g, 0);
+    cudaGraphDestroy(g);
+    return e;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// M2: the decode loop on the GPUs
+// ---------------------------------------------------------------------------------------------------------------
+
+template <class T> __device__ __forceinline__ T vld(const T* p) { return *(const volatile T*) p; }
+template <class T> __device__ __forceinline__ void vst(T* p, T v) { *(volatile T*) p = v; }
+__device__ __forceinline__ void nap() { __nanosleep(128); }
+
+struct St1 {   // GPU1's loop state, kept in device memory across tail relaunches
+    int w, x, first, pad;
+    long long p, produced, windows, offered, accepted, launches, relaunches;
+    int drafts[kMaxT];
+    float dprob[kMaxT];
+    int pen_n, pen_pad;
+    int pen_tail[kPenCap];
+};
+struct St0 {
+    int w, pad;
+    int ple_prev[2];
+    long long launches, relaunches;
+    int* ple_in;                 // M3: [T, prev0, prev1, tokens...] for the gather graph
+    cudaGraphExec_t ple_g;       // M3: the gather graph
+};
+
+// fire-and-forget, retried while the previous launch of the same graph is still retiring (it reports "invalid argument")
+__device__ int ff(cudaGraphExec_t g, long long* launches) {
+    cudaError_t e = cudaGraphLaunch(g, cudaStreamGraphFireAndForget);
+    for (int tries = 0; e == cudaErrorInvalidValue && tries < 20000; ++tries) {
+        __nanosleep(1000);
+        e = cudaGraphLaunch(g, cudaStreamGraphFireAndForget);
+    }
+    if (e == cudaSuccess) ++*launches;
+    return (int) e;
+}
+__device__ __forceinline__ void wait_done(const unsigned* c, unsigned target) {
+    while ((int) (vld(c) - target) < 0) {}
+    __threadfence_system();
+}
+
+// Verifier::stage_inputs, on the device
+__device__ void stage_window(const StageDesc& d, int T, const int* tokens, long long pos0) {
+    int32_t* const pq = d.pos;
+    int32_t* const pk = pq + (size_t) d.max_t * d.n_head;
+    int32_t* const pi = pk + (size_t) d.max_t * d.n_head_kv;
+    const long long w = (long long) d.idx_top_k + d.idx_block - 1;
+    for (int t = 0; t < T; ++t) {
+        const long long pos = pos0 + t, n_kv = pos + 1;
+        vst(&d.tok[t], (int32_t) tokens[t]);
+        vst(&d.step[t * 4 + 0], (int32_t) pos);
+        vst(&d.step[t * 4 + 1], (int32_t) n_kv);
+        vst(&d.step[t * 4 + 2], (int32_t) (n_kv / d.idx_block));
+        vst(&d.step[t * 4 + 3], (int32_t) (n_kv < w ? n_kv : w));
+        const int32_t pt = (int32_t) pos;
+        for (int h = 0; h < d.n_head; ++h) vst(&pq[t * d.n_head + h], pt);
+        for (int h = 0; h < d.n_head_kv; ++h) vst(&pk[t * d.n_head_kv + h], pt);
+        for (int h = 0; h < d.idx_q_heads; ++h) vst(&pi[t * d.idx_q_heads + h], pt);
+    }
+    vst(d.seq, 0u);
+    vst(d.flag, 0u);
+    vst(d.flagA, 0u);
+    vst(d.flagB, 0u);
+    if (d.hflag_out) vst(d.hflag_out, 0u);
+    if (d.herr) vst(d.herr, 0u);
+    if (d.hdrop) vst(d.hdrop, 0u);
+    __threadfence_system();
+}
+
+// Verifier::commit's staging and graph, on the device
+__device__ int commit_stage(const StageDesc& d, int nk, int T, long long pos0, long long* launches) {
+    vst(&d.commit[0], (int32_t) nk);
+    vst(&d.commit[1], (int32_t) (nk - 1));
+    for (int t = 0; t < d.max_t; ++t) vst(&d.commit[2 + t], t < nk ? (int32_t) (pos0 + t) : (int32_t) -1);
+    __threadfence_system();
+    if (T == 1 && d.self_commit_t1) return 0;   // a one-row window advanced the state itself
+    const unsigned base = vld(d.done);
+    const int e = ff(d.commit_exec, launches);
+    if (e != 0) return e;
+    wait_done(d.done, base + 1);
+    return 0;
+}
+
+__device__ __forceinline__ bool is_eos(const Ctl* C, int y) {
+    for (int i = 0; i < C->n_eos; ++i)
+        if (C->eos[i] == y) return true;
+    return false;
+}
+
+// MtpDrafter::draft (the --spec-min-p chain), on the device
+__device__ int draft(const MtpDesc& M, int T, const int* tokens, long long p, int a, St1* st, float min_p) {
+    const int Tm = M.catchup_all ? (T < M.max_t ? T : M.max_t) : a + 1;
+    long long ms = (long long) (M.max_t - 1 < M.max_drafts ? M.max_t - 1 : M.max_drafts);
+    if (M.max_cells - (p + a) < ms) ms = M.max_cells - (p + a);
+    const int max_steps = (int) ms;
+    const int NH = M.n_head;
+    auto put = [&](int row, long long cell) {
+        vst(&M.step[row * 4 + 0], (int32_t) cell);
+        vst(&M.step[row * 4 + 1], (int32_t) (cell + 1));
+        vst(&M.step[row * 4 + 2], (int32_t) ((cell + 1) / 4));
+        vst(&M.step[row * 4 + 3], (int32_t) (cell + 1));
+        for (int h = 0; h < NH; ++h) vst(&M.pos[row * NH + h], (int32_t) cell);
+    };
+    for (int t = 0; t < Tm; ++t) {
+        vst(&M.tok[t], (int32_t) tokens[t]);
+        put(t, p + t);
+    }
+    put(2 * M.max_t - 1, p + a);
+    for (int j = 1; j < max_steps; ++j) put(M.max_t + j - 1, p + a + j);
+    for (int j = 0; j < max_steps; ++j) vst(&M.out[j], (int32_t) -1);
+    vst(&M.row[0], (int32_t) a);
+    vst(&M.row[1], (int32_t) 0);
+    if (M.force)
+        for (int j = 0; j < 16; ++j) vst(&M.force[j], (int32_t) -1);
+    __threadfence_system();
+    int n = 0;
+    if (max_steps > 0) {
+        unsigned base = vld(M.done);
+        int e = ff(M.round[Tm], &st->launches);
+        if (e != 0) return e;
+        wait_done(M.done, base + 1);
+        st->drafts[0] = vld(&M.out[0]);
+        float pj = vld(&M.prob[0]);
+        st->dprob[0] = pj;
+        n = 1;
+        for (int j = 1; j < max_steps && pj >= min_p; ++j) {
+            base = vld(M.done);
+            e = ff(M.step_g[j], &st->launches);
+            if (e != 0) return e;
+            wait_done(M.done, base + 1);
+            st->drafts[j] = vld(&M.out[j]);
+            pj = vld(&M.prob[j]);
+            st->dprob[j] = pj;
+            ++n;
+        }
+    }
+    for (int j = n; j < M.max_t - 1 && j < kMaxT; ++j) {
+        st->drafts[j] = 0;
+        st->dprob[j] = 0.0f;
+    }
+    return 0;
+}
+
+// M3: the first stage's PLE rows on the device - ngram_rows (the hash) and iq4nl_dequant_row, bit for bit.  One block a
+// (token, head) row, 160 threads one value each; `in` = [T, prev0 (oldest), prev1 (newest), tokens 0..T-1].
+__constant__ int8_t kIq4NlDev[16] = {-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113};
+__global__ void ple_gather_kernel(const StageDesc* __restrict__ S, const int* __restrict__ in) {
+    const int T = in[0];
+    const int t = (int) blockIdx.x / 16, h = (int) blockIdx.x % 16;
+    if (t >= T) return;
+    __shared__ unsigned long long row_s;
+    if (threadIdx.x == 0) {
+        auto pred = [&](int sb) -> int {   // the token `sb` positions before token t (sb = 1: the newest)
+            const int k = t - sb;
+            return k >= 0 ? in[3 + k] : (k == -1 ? in[2] : in[1]);
+        };
+        long long ctx[3];
+        ctx[0] = in[3 + t];
+        bool cut = false;
+        for (int sb = 1; sb < 3; ++sb) {   // the cut before the store: a position whose predecessor was EOS is EOS
+            const int tk = cut ? -1 : pred(sb);
+            cut = cut || tk < 0 || tk == 248044;
+            ctx[sb] = cut ? 248044 : tk;
+        }
+        const int n = h < 8 ? 2 : 3;   // heads 0..7: bigrams, 8..15: trigrams
+        unsigned long long mixed = (unsigned long long) ctx[0] * S->ple_mult[0];
+        for (int j = 1; j < n; ++j) mixed ^= (unsigned long long) ctx[j] * S->ple_mult[j];
+        row_s = (unsigned long long) (uint32_t) (mixed % S->ple_vocab[h] + S->ple_offset[h]);
+    }
+    __syncthreads();
+    const unsigned long long row = row_s;
+    float* o = S->ple_out + ((size_t) t * 16 + h) * 160;
+    const int k = (int) threadIdx.x;
+    if (k >= 160) return;
+    if (row >= S->ple_rows) { o[k] = 0.0f; return; }   // read_row: a row past the table is +0.0f
+    const uint8_t* blk = S->ple_table + row * 90 + (size_t) (k / 32) * 18;
+    const int j = k % 32;
+    const unsigned short dbits = (unsigned short) (blk[0] | (blk[1] << 8));
+    const float d = __half2float(__ushort_as_half(dbits));
+    const int q = j < 16 ? (blk[2 + j] & 0x0F) : (blk[2 + j - 16] >> 4);
+    o[k] = __fmul_rn(d, (float) kIq4NlDev[q]);
+}
+__global__ void ple_flag_kernel(const StageDesc* __restrict__ S) {
+    __threadfence_system();   // every row above is in the mapped buffer first
+    *(volatile uint32_t*) S->flag = 1u;
+    __threadfence_system();
+}
+
+__device__ void finish1(Ctl* C, St1* st, int reason, int err = 0, int where = 0) {
+    vst(&C->p_end, st->p);
+    vst(&C->x_end, st->x);
+    vst(&C->windows, st->windows);
+    vst(&C->offered, st->offered);
+    vst(&C->accepted, st->accepted);
+    vst(&C->launches1, st->launches);
+    vst(&C->relaunches1, st->relaunches);
+    if (err) {
+        vst(&C->err, err);
+        vst(&C->err_where, where);
+    }
+    __threadfence_system();
+    vst(&C->exit_req, 1);
+    __threadfence_system();
+    vst(&C->finished, reason);
+    __threadfence_system();
+}
+
+// GPU1: the last stage, the head and the drafter
+__global__ void sched1(const StageDesc* __restrict__ S, const MtpDesc* __restrict__ M, Ctl* C, St1* st) {
+    if (threadIdx.x != 0 || blockIdx.x != 0) return;
+    const int per_window = 3 + (M->max_t > 1 ? M->max_t - 1 : 1);
+    long long launched = 0;   // in this graph execution
+    for (;;) {
+        const long long cap = C->max_new;
+        long long produced = st->produced;
+        if (produced >= cap) { finish1(C, st, kLength); return; }
+        if (launched + per_window > kFFLimit) {   // window recovery: a fresh execution of this graph, same state
+            ++st->relaunches;
+            __threadfence();
+            cudaGraphLaunch(cudaGetCurrentGraphExec(), cudaStreamGraphTailLaunch);
+            return;
+        }
+        int T = 1;
+        if (!st->first)
+            while (T < C->S_mtp && st->dprob[T - 1] >= C->min_p) ++T;
+        const long long p = st->p;
+        if (p + T > C->max_context) { finish1(C, st, kContext); return; }
+        int win[kMaxT];
+        win[0] = st->x;
+        for (int i = 1; i < T; ++i) win[i] = st->drafts[i - 1];
+        const int w = st->w + 1;
+        // the window to GPU0
+        vst(&C->T, T);
+        vst(&C->p, p);
+        for (int i = 0; i < T; ++i) vst(&C->tokens[i], win[i]);
+        __threadfence_system();
+        vst(&C->win_seq, w);
+        __threadfence_system();
+        stage_window(*S, T, win, p);
+        while (vld(&C->s0_done) < w) {
+            if (vld(&C->err) != 0) { finish1(C, st, kError); return; }
+            nap();
+        }
+        __threadfence_system();
+        // this GPU's half
+        const long long l0 = st->launches;
+        unsigned base = vld(S->done);
+        int e = ff(S->win[T], &st->launches);
+        if (e != 0) { finish1(C, st, kError, e, 1); return; }
+        wait_done(S->done, base + 1);
+        if (S->samp[T] != nullptr) {   // repetition penalties: the penalised pick again, over each row's history (penalty_rows)
+            const int h = S->hist_len;
+            for (int t = 0; t < T; ++t) {
+                int32_t* row = S->hist + (size_t) t * h;
+                const int avail = st->pen_n + t + 1;
+                const int take = avail < h ? avail : h;
+                for (int j = 0; j < h - take; ++j) row[j] = -1;
+                for (int j = 0; j < take; ++j) {
+                    const int i = avail - take + j;
+                    row[h - take + j] = i < st->pen_n ? st->pen_tail[i] : win[i - st->pen_n];
+                }
+            }
+            __threadfence();
+            base = vld(S->done);
+            e = ff(S->samp[T], &st->launches);
+            if (e != 0) { finish1(C, st, kError, e, 4); return; }
+            wait_done(S->done, base + 1);
+        }
+        int outv[kMaxT];
+        for (int t = 0; t < T; ++t) outv[t] = vld(&S->out[t]);
+        int nf_row = -1;
+        if (S->nf != nullptr)
+            for (int t = 0; t < T && nf_row < 0; ++t)
+                for (int b = 0; b < S->nf_blocks; ++b)
+                    if (vld(&S->nf[t * S->nf_blocks + b]) != 0) { nf_row = t; break; }
+        // accept: the longest run of drafts the model agrees with, cut at an EOS and at the token cap
+        int a = 0;
+        while (a < T - 1 && win[a + 1] == outv[a]) ++a;
+        {
+            const long long rem = cap - produced;
+            const int cnt = (int) ((long long) (a + 1) < (rem > 0 ? rem : 0) ? (long long) (a + 1) : (rem > 0 ? rem : 0));
+            int bound = cnt;
+            for (int i = 0; i < cnt; ++i)
+                if (is_eos(C, outv[i])) { bound = i + 1; break; }
+            a = bound - 1;
+        }
+        // commit, both stages
+        vst(&C->n_keep, a + 1);
+        __threadfence_system();
+        vst(&C->commit_seq, w);
+        __threadfence_system();
+        e = commit_stage(*S, a + 1, T, p, &st->launches);
+        if (e != 0) { finish1(C, st, kError, e, 2); return; }
+        while (vld(&C->s0_commit_done) < w) {
+            if (vld(&C->err) != 0) { finish1(C, st, kError); return; }
+            nap();
+        }
+        __threadfence_system();
+        st->w = w;
+        ++st->windows;
+        vst(&C->last_T, T);
+        vst(&C->last_a, a);
+        vst(&C->last_p, p);
+        for (int i = 0; i < T; ++i) vst(&C->last_window[i], win[i]);
+        if (nf_row >= 0) { finish1(C, st, kNonfinite); return; }   // none of its tokens goes out
+        if (S->samp[T] != nullptr)   // the state consumed window[0..a]: the penalties' tail grows by them
+            for (int i = 0; i <= a; ++i) {
+                const int h = S->hist_len;
+                if (st->pen_n < h) {
+                    st->pen_tail[st->pen_n++] = win[i];
+                } else {
+                    for (int j = 1; j < h; ++j) st->pen_tail[j - 1] = st->pen_tail[j];
+                    st->pen_tail[h - 1] = win[i];
+                }
+            }
+        st->offered += T - 1;
+        st->accepted += a;
+        st->first = 0;
+        // emit
+        bool eos = false;
+        for (int i = 0; i <= a && produced < cap && !eos; ++i) {
+            while (produced - vld(&C->consumed) >= (long long) kRing) nap();
+            vst(&C->ring[produced % kRing], outv[i]);
+            ++produced;
+            eos = is_eos(C, outv[i]);
+        }
+        __threadfence_system();
+        vst(&C->produced, produced);
+        __threadfence_system();
+        st->produced = produced;
+        // draft the next window
+        if (!eos && produced < cap) {
+            e = draft(*M, T, outv, p, a, st, C->min_p);
+            if (e != 0) { finish1(C, st, kError, e, 3); return; }
+        }
+        launched += st->launches - l0;
+        if (eos) { finish1(C, st, kStop); return; }
+        if (vld(&C->stop) != 0) { finish1(C, st, kCancel); return; }
+        st->x = outv[a];
+        st->p = p + a + 1;
+    }
+}
+
+// GPU0: the first stage
+__global__ void sched0(const StageDesc* __restrict__ S, Ctl* C, St0* st) {
+    if (threadIdx.x != 0 || blockIdx.x != 0) return;
+    long long launched = 0;
+    for (;;) {
+        const int w = st->w + 1;
+        for (;;) {
+            if (vld(&C->win_seq) >= w) break;
+            if (vld(&C->exit_req) != 0) {
+                vst(&C->ple_prev_end[0], st->ple_prev[0]);
+                vst(&C->ple_prev_end[1], st->ple_prev[1]);
+                vst(&C->launches0, st->launches);
+                vst(&C->relaunches0, st->relaunches);
+                __threadfence_system();
+                return;
+            }
+            nap();
+        }
+        if (launched + 3 > kFFLimit) {
+            ++st->relaunches;
+            __threadfence();
+            cudaGraphLaunch(cudaGetCurrentGraphExec(), cudaStreamGraphTailLaunch);
+            return;
+        }
+        __threadfence_system();
+        const int T = vld(&C->T);
+        const long long p = vld(&C->p);
+        int tok[kMaxT];
+        for (int i = 0; i < T; ++i) tok[i] = vld(&C->tokens[i]);
+        stage_window(*S, T, tok, p);
+        const long long l0 = st->launches;
+        int e = 0;
+        if (S->ple_mode == 2) {   // M3: the rows gathered on this GPU, beside the window (its layer 1 waits for the flag)
+            st->ple_in[0] = T;
+            st->ple_in[1] = st->ple_prev[0];
+            st->ple_in[2] = st->ple_prev[1];
+            for (int i = 0; i < T; ++i) st->ple_in[3 + i] = tok[i];
+            __threadfence();
+            e = ff(st->ple_g, &st->launches);
+            if (e != 0) { vst(&C->err_where, 13); __threadfence_system(); vst(&C->err, e); return; }
+        }
+        const unsigned base = vld(S->done);
+        e = ff(S->win[T], &st->launches);
+        if (e != 0) { vst(&C->err_where, 10); __threadfence_system(); vst(&C->err, e); return; }
+        if (S->ple_mode == 1) {   // M2: the host gathers them and raises the flag layer 1 waits on
+            vst(&C->ple_T, T);
+            for (int i = 0; i < T; ++i) vst(&C->ple_tokens[i], tok[i]);
+            vst(&C->ple_prev[0], st->ple_prev[0]);
+            vst(&C->ple_prev[1], st->ple_prev[1]);
+            __threadfence_system();
+            vst(&C->ple_seq, w);
+            __threadfence_system();
+        } else if (S->ple_mode == 0) {
+            vst(S->flag, 1u);
+            __threadfence_system();
+        }
+        wait_done(S->done, base + 1);
+        if (S->plan_err != nullptr && vld(S->plan_err) != 0) {
+            vst(&C->err_where, 11); __threadfence_system(); vst(&C->err, -1); return;
+        }
+        vst(&C->s0_done, w);
+        __threadfence_system();
+        while (vld(&C->commit_seq) < w) {
+            if (vld(&C->exit_req) != 0) return;   // (GPU1 always commits a window it ran; an error ends it)
+            nap();
+        }
+        __threadfence_system();
+        const int nk = vld(&C->n_keep);
+        e = commit_stage(*S, nk, T, p, &st->launches);
+        if (e != 0) { vst(&C->err_where, 12); __threadfence_system(); vst(&C->err, e); return; }
+        for (int t = 0; t < nk; ++t) {   // the session's PLE history advances by the kept rows
+            st->ple_prev[0] = st->ple_prev[1];
+            st->ple_prev[1] = tok[t];
+        }
+        st->w = w;
+        launched += st->launches - l0;
+        __threadfence_system();
+        vst(&C->s0_commit_done, w);
+        __threadfence_system();
+    }
+}
+
+cudaError_t make_sched_graph(cudaStream_t q, bool first_stage, const StageDesc* s, const MtpDesc* m, Ctl* c, void* st,
+                             cudaGraphExec_t* out) {
+    cudaGraph_t g = nullptr;
+    cudaError_t e = cudaStreamBeginCapture(q, cudaStreamCaptureModeThreadLocal);
+    if (e != cudaSuccess) return e;
+    if (first_stage) sched0<<<1, 32, 0, q>>>(s, c, (St0*) st);
+    else sched1<<<1, 32, 0, q>>>(s, m, c, (St1*) st);
+    e = cudaStreamEndCapture(q, &g);
+    if (e != cudaSuccess) return e;
+    e = cudaGraphInstantiateWithFlags(out, g, cudaGraphInstantiateFlagDeviceLaunch);
+    cudaGraphDestroy(g);
+    if (e == cudaSuccess) e = cudaGraphUpload(*out, q);
+    return e;
+}
