+        if (groups_[T] > 1) { err = "blink: split token groups"; return false; }   // (set by the capture)
+    }
+    if (!capture_commit(err) || commit_exec_ == nullptr) { if (err.empty()) err = "blink: the commit graph is missing"; return false; }
+    unsigned long long fl = 0;
+    if (cudaGraphExecGetFlags(exec_[0][1], &fl) != cudaSuccess || (fl & cudaGraphInstantiateFlagDeviceLaunch) == 0) {
+        (void) cudaGetLastError();
+        err = "blink: the window graphs were not instantiated for device launch";
+        return false;
+    }
+    const ModelGeometry& g = *g_;
+    const QsaShapes s = shapes_of(g);
+    d = strata::blink::StageDesc{};
+    d.tok = m_tok_; d.step = m_step_; d.pos = m_pos_;
+    d.seq = m_seq_; d.flag = m_flag_; d.flagA = m_flagA_; d.flagB = m_flagB_;
+    d.hflag_out = hflag_out_h_; d.herr = herr_h_; d.hdrop = hdrop_h_;   // mapped (UVA: the host address is the device's)
+    d.commit = m_commit_;
+    d.out = last_stage() ? m_out_ : nullptr;
+    d.nf = (nan_guard_on() && last_stage() && m_nf_ != nullptr) ? m_nf_ : nullptr;
+    d.nf_blocks = kNonfiniteBlocks;
+    d.plan_err = m_plan_err_;
+    d.n_head = (int) g.n_head; d.n_head_kv = (int) g.n_head_kv; d.idx_q_heads = (int) g.idx_q_heads;
+    d.idx_block = (int) s.idx_block; d.idx_top_k = (int) s.idx_top_k; d.max_t = max_t_;
+    d.self_commit_t1 = (!always_publish_ && one_token_self_commit() && !g_qfuse()) ? 1 : 0;
+    for (int T = 1; T <= max_T; ++T) d.win[T] = exec_[0][T];
+    d.commit_exec = commit_exec_;
+    if (last_stage() && head_sampling_) {
+        const bool sampled = !sampling_.greedy && sampling_.temperature > 0.0f;
+        if (sampled) { err = "blink: a sampled request"; return false; }
+        if (sampling_.logit_bias != nullptr) { err = "blink: a logit bias"; return false; }
+        if (hist_d_ != nullptr) {
+            if (hist_len_ < 1 || hist_len_ > strata::blink::kPenCap) { err = "blink: penalty window out of range"; return false; }
+            const bool same = blink_samp_key_.h == hist_d_ && blink_samp_key_.n == hist_len_ &&
+                              blink_samp_key_.last_n == sampling_.penalty_last_n && blink_samp_key_.rep == sampling_.penalty_repeat &&
+                              blink_samp_key_.freq == sampling_.penalty_freq && blink_samp_key_.pres == sampling_.penalty_present;
+            if (!same) {   // another request's penalties: the pick is captured again (its parameters are baked in)
+                for (auto& x : blink_samp_) if (x != nullptr) { cudaGraphExecDestroy(x); x = nullptr; }
+                blink_samp_key_.h = hist_d_; blink_samp_key_.n = hist_len_; blink_samp_key_.last_n = sampling_.penalty_last_n;
+                blink_samp_key_.rep = sampling_.penalty_repeat; blink_samp_key_.freq = sampling_.penalty_freq;
+                blink_samp_key_.pres = sampling_.penalty_present;
+            }
+            for (int T = 1; T <= max_T; ++T) {
+                if (blink_samp_[T] == nullptr) {
+                    if (cudaStreamBeginCapture(cs_, cudaStreamCaptureModeThreadLocal) != cudaSuccess) { err = "blink: begin pick capture"; return false; }
+                    SamplerParams sp = sampling_;
+                    sp.counter = 0;   // greedy: the pick reads no draw
+                    sample_tokens(head_logits_, T, (int) n_vocab_, hist_d_, hist_len_, sp, m_out_, cs_);
+                    strata::blink::capture_done(cs_);
+                    cudaGraph_t graph = nullptr;
+                    const cudaError_t ce = cudaStreamEndCapture(cs_, &graph);
+                    if (ce != cudaSuccess) { err = std::string("blink: pick capture: ") + cudaGetErrorString(ce); return false; }
+                    const cudaError_t ie = strata::blink::instantiate(&blink_samp_[T], graph, 0);
+                    cudaGraphDestroy(graph);
+                    if (ie != cudaSuccess) { blink_samp_[T] = nullptr; err = std::string("blink: pick instantiate: ") + cudaGetErrorString(ie); return false; }
+                    (void) cudaGraphUpload(blink_samp_[T], cs_);
+                }
+                d.samp[T] = blink_samp_[T];
+            }
+            d.hist = const_cast<int32_t*>(hist_d_);
+            d.hist_len = hist_len_;
+            (void) cudaStreamSynchronize(cs_);
+        }
+    }
+    d.done = strata::blink::done_counter(device_);
+    d.device = device_;
+    // the first stage's PLE rows: on the device (M3) when the table is in memory, IQ4_NL, and registered for the GPUs
+    static_assert(NGRAM_SIZE == 3 && PLE_N_HEADS == 16 && PLE_HEAD_DIM == 160 && PLE_ROW_BYTES == 90 && PLE_EOS_TOKEN_ID == 248044,
+                  "the device PLE gather (blink.cu) assumes this table geometry");
+    d.ple_mode = 0;
+    if (ple_stage() && ss_ != nullptr && ss_->ple.ready()) {
+        d.ple_mode = 1;
+        const char* pm = std::getenv("STRATA_BLINK_PLE");
+        const bool want_dev = pm == nullptr || std::strcmp(pm, "host") != 0;
+        const uint8_t* rows = ss_->ple.table != nullptr ? ss_->ple.table->mapped_rows() : nullptr;
+        const char* why = nullptr;
+        if (!want_dev) why = "STRATA_BLINK_PLE=host";
+        else if (rows == nullptr) why = "the table is read from the SSD (--ple-io ram or mmap keeps it in memory)";
+        else if (!ss_->ple.table->is_iq4nl()) why = "the table is not IQ4_NL";
+        if (why == nullptr) {
+            const uint64_t nr = ss_->ple.table->rows();
+            const void* dt = strata::blink::register_table(rows, (size_t) nr * PLE_ROW_BYTES);
+            if (dt == nullptr) why = "the table could not be registered for the GPUs";
+            else {
+                d.ple_mode = 2;
+                d.ple_table = (const uint8_t*) dt;
+                d.ple_rows = nr;
+                d.ple_out = m_ple_;
+                for (int i = 0; i < NGRAM_SIZE; ++i) d.ple_mult[i] = ss_->ple.consts.mult[i];
+                for (int h = 0; h < PLE_N_HEADS; ++h) { d.ple_vocab[h] = ss_->ple.consts.vocab[h]; d.ple_offset[h] = ss_->ple.consts.offset[h]; }
+            }
+        }
+        static bool said = false;
+        if (!said) {
+            said = true;
+            if (why) std::fprintf(stderr, "strata blink: the PLE rows are gathered by the host (M2): %s\n", why);
+            else std::fprintf(stderr, "strata blink: the PLE rows are gathered on the GPU (M3)\n");
+        }
+    }
+    if (d.done == nullptr) { err = "blink: no completion counter"; return false; }
+    if (last_stage() && d.out == nullptr) { err = "blink: no output rows"; return false; }
+    return true;
+#endif
+}
