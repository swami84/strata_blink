+
+bool loop_on() {
+    static const bool on = [] {
+        const char* v = std::getenv("STRATA_BLINK");
+        const bool o = v != nullptr && std::atoi(v) != 0;
+        if (o) std::fprintf(stderr, "strata blink: M2 on - the decode loop runs on the GPUs where it can (STRATA_BLINK=1)\n");
+        return o;
+    }();
+    return on;
+}
+
+bool devlaunch_on() {
+    static const bool on = [] {
+        const char* v = std::getenv("STRATA_BLINK_DEVLAUNCH");
+        const bool o = (v != nullptr && std::atoi(v) != 0) || loop_on();
+        if (o && !loop_on())
+            std::fprintf(stderr, "strata blink: M1 on - verify / commit / MTP graphs are launched from the GPU (fire-and-forget)\n");
+        return o;
+    }();
+    return on;
+}
+
+void prepare_device(int device) {
+    if (!loop_on() || device < 0 || device >= 16) return;
+    Registry& r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    if (r.done[device] != nullptr) return;
+    int prev = 0;
+    cudaGetDevice(&prev);
+    if (prev != device) cudaSetDevice(device);
+    // load this module's kernels on the device now: a lazily loaded kernel first launched inside a capture is not safe
+    cudaFuncAttributes fa{};
+    (void) cudaFuncGetAttributes(&fa, (const void*) done_bump);
+    (void) cudaFuncGetAttributes(&fa, (const void*) ff_launch);
+    (void) cudaFuncGetAttributes(&fa, (const void*) sched0);
+    (void) cudaFuncGetAttributes(&fa, (const void*) sched1);
+    unsigned* c = nullptr;
+    if (cudaMalloc((void**) &c, 64) == cudaSuccess && cudaMemset(c, 0, 64) == cudaSuccess && cudaDeviceSynchronize() == cudaSuccess) {
+        r.done[device] = c;
+        std::fprintf(stderr, "strata blink: device %d prepared (completion counter, loop kernels loaded)\n", device);
+    } else {
+        std::fprintf(stderr, "strata blink: device %d could not be prepared: %s\n", device, cudaGetErrorString(cudaGetLastError()));
+    }
+    if (prev != device) cudaSetDevice(prev);
+}
+
+unsigned* done_counter(int device) {
+    if (device < 0 || device >= 16) return nullptr;
+    Registry& r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    return r.done[device];
+}
+
+const void* register_table(const void* p, size_t bytes) {
+    static std::mutex mu;
+    static const void* done_p = nullptr;
+    static const void* done_d = nullptr;
+    std::lock_guard<std::mutex> lk(mu);
+    if (p == nullptr || bytes == 0) return nullptr;
+    if (done_p == p) return done_d;
+    const size_t pg = 4096;
+    const uintptr_t a = (uintptr_t) p & ~(uintptr_t) (pg - 1);
+    const size_t len = (((uintptr_t) p + bytes - a) + pg - 1) & ~(pg - 1);
+    const auto t0 = std::chrono::steady_clock::now();
+    auto secs = [&] { return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count(); };
+    // 1) the mapping itself, read only, then writable (a file mapping is often refused: "operation not supported")
+    for (unsigned extra : {(unsigned) cudaHostRegisterReadOnly, 0u}) {
+        if (cudaHostRegister((void*) a, len, cudaHostRegisterMapped | cudaHostRegisterPortable | extra) == cudaSuccess) {
+            void* d = nullptr;
+            if (cudaHostGetDevicePointer(&d, (void*) a, 0) == cudaSuccess) {
+                done_p = p;
+                done_d = (const uint8_t*) d + ((uintptr_t) p - a);
+                std::fprintf(stderr, "strata blink: the PLE table (%.1f GiB) is registered in place for the GPUs (%.1f s)\n",
+                             (double) len / 1073741824.0, secs());
+                return done_d;
+            }
+            cudaHostUnregister((void*) a);
+        }
+        (void) cudaGetLastError();
+    }
+    // 2) a pinned, mapped copy (as the expert arena is pinned): the table read once into it, in parallel
+    void* h = nullptr;
+    if (cudaHostAlloc(&h, bytes, cudaHostAllocMapped | cudaHostAllocPortable) != cudaSuccess) {
+        std::fprintf(stderr, "strata blink: no pinned copy of the PLE table (%.1f GiB): %s\n", (double) bytes / 1073741824.0,
+                     cudaGetErrorString(cudaGetLastError()));
+        return nullptr;
+    }
+    {
+        const int nt = 8;
+        std::vector<std::thread> th;
+        const size_t chunk = (bytes + nt - 1) / nt;
+        for (int i = 0; i < nt; ++i)
+            th.emplace_back([&, i] {
+                const size_t b = (size_t) i * chunk, e2 = std::min(bytes, b + chunk);
+                if (b < e2) std::memcpy((uint8_t*) h + b, (const uint8_t*) p + b, e2 - b);
+            });
+        for (auto& x : th) x.join();
+    }
+    void* d = nullptr;
+    if (cudaHostGetDevicePointer(&d, h, 0) != cudaSuccess) { (void) cudaGetLastError(); cudaFreeHost(h); return nullptr; }
+    done_p = p;
+    done_d = d;
+    std::fprintf(stderr, "strata blink: the PLE table (%.1f GiB) is copied to pinned memory the GPUs read (%.1f s)\n",
+                 (double) bytes / 1073741824.0, secs());
+    return done_d;
+}
+
+void capture_done(cudaStream_t s) {
+    if (!loop_on()) return;
+    int dev = 0;
+    if (cudaStreamGetDevice(s, &dev) != cudaSuccess) {
+        (void) cudaGetLastError();
+        cudaGetDevice(&dev);
+    }
+    unsigned* c = done_counter(dev);
+    if (c != nullptr) done_bump<<<1, 1, 0, s>>>(c);
+    else std::fprintf(stderr, "strata blink: device %d was not prepared: a graph without its completion bump\n", dev);
+}
+
+cudaError_t instantiate(cudaGraphExec_t* ex, cudaGraph_t g, unsigned long long flags) {
+    if (!devlaunch_on()) return cudaGraphInstantiate(ex, g, flags);
+    const cudaError_t e = cudaGraphInstantiate(ex, g, flags | cudaGraphInstantiateFlagDeviceLaunch);
+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "strata blink: instantiate for device launch failed: %s\n", cudaGetErrorString(e));
+        return e;
+    }
+    Registry& r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    r.uploaded.erase(*ex);   // a reused handle value is a new graph
+    r.launcher.erase(*ex);
+    return e;
+}
+
+cudaError_t launch(cudaGraphExec_t ex, cudaStream_t s) {
+    if (!devlaunch_on()) return cudaGraphLaunch(ex, s);
+    // the graph's own flags, not a registry: Strata destroys and recaptures graphs, and a handle value can come back
+    unsigned long long fl = 0;
+    if (cudaGraphExecGetFlags(ex, &fl) != cudaSuccess || (fl & cudaGraphInstantiateFlagDeviceLaunch) == 0)
+        return cudaGraphLaunch(ex, s);   // not instantiated for device launch: as before
+    Registry& r = reg();
+    cudaGraphExec_t le = nullptr;
+    {
+        std::lock_guard<std::mutex> lk(r.mu);
+        if (!ensure_err(r)) return cudaErrorMemoryAllocation;
+        if (const int de = *(volatile int*) r.h_err; de != 0) {
+            std::fprintf(stderr, "strata blink: an earlier device-side graph launch failed: %s\n",
+                         cudaGetErrorString((cudaError_t) de));
+            return (cudaError_t) de;
+        }
+        if (r.uploaded.insert(ex).second) {
+            const cudaError_t ue = cudaGraphUpload(ex, s);   // a device launch needs the graph on the device first
+            if (ue != cudaSuccess) {
+                r.uploaded.erase(ex);
+                return ue;
+            }
+        }
+        auto it = r.launcher.find(ex);
+        if (it == r.launcher.end()) {
+            const cudaError_t me = make_launcher(r, ex, &le);
+            if (me != cudaSuccess) return me;
+            r.launcher.emplace(ex, le);
+        } else {
+            le = it->second;
+        }
+    }
+    const long long n = ++r.launches;
+    if (n == 1 || n == 1000 || n == 100000)
+        std::fprintf(stderr, "strata blink: %lld host-requested device-side graph launches so far\n", n);
+    return cudaGraphLaunch(le, s);
+}
